 "beats": {
  "0a": {
   "what": "深夜办公室，人对着只有一行空输入框的屏幕，手指悬在回车上，桌角玻璃管里 Twin 在睡",
   "vo": "有些硬骨头，得熬上好几个月。",
   "caption": null
  },
  "1a": {
   "what": "玻璃管里打盹的 Twin，随呼吸微微起伏",
   "vo": "谷歌最新模型叫 Argon，意思是：懒。",
   "caption": "Argon（氩）：源自希腊语“懒惰”"
  },
  "1b": {
   "what": "深夜书房里，一只手刚按灭桌面台灯，另一侧空办公椅被轻轻推回桌下；房间陷入深蓝夜色，唯有桌角透明玻璃管里的淡紫色星星 Twin 骤然苏醒，通体亮起温暖明亮的淡紫色光芒，照亮幽暗的桌面。",
   "vo": "不是它懒。是有它，你能偷懒。",
   "caption": null
  },
  "2a": {
   "what": "Twin 身后吐出一条无尽长的发光纸带，绕出窗外直达天边，计数器跳到 1,000,000",
   "vo": "一口气输出百万 token，深想到底。",
   "caption": "输出上限 100 万 token（此前 6.4 万）"
  },
  "2b": {
   "what": "由代码堆成的巨大城市里，Twin 钻进去把一整片缠成一团的老街区拆开、理顺",
   "vo": "六百万行老代码，几周就拆解重构。",
   "caption": "Chromium 架构重构：数月压至数周"
  },
  "2c": {
   "what": "夜色下的书桌前，立着一个大型半圆形速度仪表盘（仅有刻度线，无数字文字），淡紫色星星 Twin 鼓起腮帮子，双手发力将仪表盘指针往右侧极限刻度猛推到底，指针划出一道凌厉的淡紫色弧形光轨与火花。",
   "vo": "底层优化几天干完，提速近三倍。",
   "caption": "Gemma 4 提速 2.85 倍，零质量损失"
  },
  "2d": {
   "what": "医院档案库大门上的细裂缝，Twin 用紫光精准照亮并把它焊死",
   "vo": "连隐秘的致命漏洞，也顺手焊死。",
   "caption": "自主修补漏洞，护住数十万病历"
  },
  "2e": {
   "what": "三块面板环绕亮起：核聚变仿星器、发光的错位 DNA、紫外下发光的烧瓶",
   "vo": "为六十年的聚变难题找到新反例，揪出罕见病基因，几小时设计出新酶。",
   "caption": "Grad 猜想新反例 · 罕见病基因 · 新酶"
  },
  "3a": {
   "what": "三维空间透视网格中，一座多层木构古寺宝塔与庭院正在由铅笔线框生长为温润的水彩立体建筑，屋檐下灯笼逐一亮起暖光；淡紫色星星 Twin 悬停在飞檐旁，拿着小小放大镜仔细审视斗拱结构，一缕淡紫光束正自动微调并补全屋顶瓦片。",
   "vo": "它还懂空间。边建边改，搭出整座古寺。",
   "caption": "多智能体视觉自检 3D 建模"
  },
  "3b": {
   "what": "几张平铺的书桌实景照片在淡紫光中立起、延伸融合成真实的书桌三维微缩赛场，水杯、笔筒与订书机化作赛道弯道障碍；一辆涂有淡紫条纹的迷你小赛车正绕过水杯漂移疾驰、扬起水彩烟尘，淡紫色星星 Twin 在赛道旁兴奋地挥舞小旗引导。",
   "vo": "几张书桌照，变成能玩的赛车游戏。",
   "caption": "建模·碰撞·引擎声全自动，AI Studio 可玩"
  },
  "3c": {
